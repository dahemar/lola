---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import { getSiteData } from '../lib/cms/getSite'

const site = await getSiteData(Astro.locals)
---
<Base title={site.siteMeta.name}>
  <Nav slot="nav" />
  <article>
    <section class="shows-list">
      <h3 class="section-title">live</h3>
      <ul>
        {site.liveShows.map((show) => (
          <li><strong>{show.date}</strong> — {show.text}</li>
        ))}
      </ul>
    </section>
  </article>
</Base>
