---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import { getSiteData } from '../lib/cms/getSite'

const site = await getSiteData(Astro.locals)
---
<Base title={site.siteMeta.name}>
  <Nav slot="nav" />
  <article>
    <header>
      <h3 class="section-title">contact</h3>
    </header>
    <section>
      {site.contactEmails.map((email) => (
        <p><a href={`mailto:${email}`}>{email}</a></p>
      ))}
    </section>
  </article>
</Base>
