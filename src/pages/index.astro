---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import StreamingIcon from '../components/StreamingIcon.astro'
import { getSiteData } from '../lib/cms/getSite'

const site = await getSiteData(Astro.locals)
const coverFallback = "data:image/svg+xml;utf8,<svg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 300 300%27><rect width=%27100%25%27 height=%27100%25%27 fill=%27%23efefef%27/><text x=%2750%25%27 y=%2750%25%27 font-size=%2720%27 text-anchor=%27middle%27 fill=%27%23666%27 dy=%27.3em%27>cover</text></svg>"
---

<Base title={site.siteMeta.name}>
  <Nav slot="nav" />

  <article>
    <section class="music-list">

      <div class="page-hero">
        <img src={site.heroImage} alt={site.heroAlt} width="900" height="600" loading="eager" />
      </div>

      <div id="releases" class="music-section">
        <h3 class="section-title">releases</h3>
        <div class="releases-grid">
          {site.releases.map((release) => (
            <div class="release-thumb" data-title={release.title}>
              <img
                src={release.image}
                alt={`${release.title} cover`}
                onerror={`this.onerror=null;this.src='${coverFallback}'`}
              />
              <span class="thumb-label">{release.title}</span>
            </div>
          ))}
        </div>
      </div>

      <div id="links" class="music-section">
        <h3 class="section-title">streaming</h3>
        <ul class="streaming-grid">
          {site.streaming.map((link) => (
            <li>
              <a href={link.href} class="streaming-link" target="_blank" rel="noopener">
                <StreamingIcon platform={link.platform} size={22} />
                <span class="streaming-label">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="top-columns-wrapper music-section">
        <div id="broadcasts">
          <h3 class="section-title">broadcasts</h3>
          <ul>
            {site.broadcasts.map((b) => (
              <li>
                <a href={b.url} target="_blank" rel="noopener">{b.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div id="playlists">
          <h3 class="section-title">playlists</h3>
          <ul>
            {site.playlists.map((item) => (
              <li><a href={item.url} target="_blank" rel="noopener">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div id="press">
          <h3 class="section-title">press</h3>
          <ul>
            {site.press.map((item) => (
              <li><a href={item.url} target="_blank" rel="noopener">{item.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <div id="videos" class="music-section">
        <h3 class="section-title">music videos</h3>
        <div class="videos">
          {site.videos.map((video) => (
            <div class="video-wrap">
              <iframe
                src={video.embedUrl}
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          ))}
        </div>
      </div>

    </section>
  </article>

</Base>
